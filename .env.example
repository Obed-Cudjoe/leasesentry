# ------------------------------------------------------------------
# Menu Truth Engine — environment variables
# Copy this file to `.env.local` and fill in your real values.
# NEVER commit .env.local to git (it's already in .gitignore).
# ------------------------------------------------------------------

# Turso (free-tier, edge SQLite / libSQL) — database for form submissions.
# Get both from the Turso dashboard (https://console.turso.tech):
#   - create a database (name it e.g. "menu-truth")
#   - copy the "Hosted" URL → TURSO_DATABASE_URL
#   - generate an auth token (Sqlite: Create token) → TURSO_AUTH_TOKEN
#
# Without these, the site still runs in demo mode and saves form
# submissions to `data/submissions.json` locally. Add them and the
# same forms write to your real Turso database instead.
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-token-here
